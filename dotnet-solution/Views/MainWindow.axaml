<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpliceIt.ViewModels"
        xmlns:models="using:SpliceIt.Models"
        xmlns:controls="using:SpliceIt.Controls"
        xmlns:conv="using:SpliceIt.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SpliceIt.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ProjectName, StringFormat='SpliceIt - {0}'}"
        Background="#1E1E1E"
        Foreground="#ECECEC"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <!-- Design-time DataContext -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,240">
        <!-- 1. TOP TRANSPORT BAR -->
        <Border Grid.Row="0" Background="#161616" BorderBrush="#282828" BorderThickness="0,0,0,1" Height="48" Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Project Name & Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="SPLICEIT" FontWeight="ExtraBold" FontSize="14" Foreground="#00D2FF" VerticalAlignment="Center"/>
                    <Border Background="#242424" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text=".siq" FontSize="10" FontFamily="Consolas" Foreground="#AAAAAA"/>
                    </Border>
                    <TextBox Text="{Binding ProjectName}" Width="160" Background="#202020" BorderBrush="#333333" Foreground="White" Margin="8,0,0,0"/>

                    <!-- Phase 1: these commands finally have file dialogs behind them. -->
                    <Button Classes="ToolbarBtn" Command="{Binding ImportAudioCommand}"
                            ToolTip.Tip="Import audio (WAV, MP3, FLAC, OGG, M4A)" Margin="8,0,0,0">
                        <TextBlock Text="＋ Import"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenProjectCommand}" ToolTip.Tip="Open .siq project">
                        <TextBlock Text="Open"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Save .siq project">
                        <TextBlock Text="Save"/>
                    </Button>
                </StackPanel>

                <!-- Transport Center Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ToolbarBtn" Command="{Binding StopCommand}">
                        <TextBlock Text="■ Stop"/>
                    </Button>

                    <!--
                        The label was previously bound as
                          {Binding IsPlaying, Converter={x:Null}, StringFormat='▶ Play'}
                        An explicitly null Converter is meaningless and the text could
                        never change. Two mutually exclusive TextBlocks driven by the
                        bool (and its negation) are simpler than a converter.
                    -->
                    <Button Classes="ToolbarBtn" Command="{Binding TogglePlayCommand}"
                            Background="#00D2FF" Foreground="#000000" FontWeight="Bold">
                        <Panel>
                            <TextBlock Text="▶ Play" IsVisible="{Binding !IsPlaying}"/>
                            <TextBlock Text="❚❚ Pause" IsVisible="{Binding IsPlaying}"/>
                        </Panel>
                    </Button>

                    <Button Classes="ToolbarBtn" Command="{Binding SplitClipAtPlayheadCommand}" ToolTip.Tip="Split Selected Clip at Playhead (S)">
                        <TextBlock Text="✂ Split (S)"/>
                    </Button>

                    <ToggleButton Classes="ChannelToggle" Width="44" IsChecked="{Binding IsLooping}" ToolTip.Tip="Loop playback">
                        <TextBlock Text="↻"/>
                    </ToggleButton>

                    <Border Background="#121214" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPlayheadSeconds, StringFormat='{}{0:F2} s'}"
                                   FontFamily="Consolas" FontSize="12" Foreground="#00D2FF"/>
                    </Border>
                </StackPanel>

                <!-- Export & Save Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#121214" BorderBrush="#2D2D2F" BorderThickness="1" CornerRadius="4" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="ToolbarBtn" Command="{Binding ZoomOutCommand}" Padding="6,2" ToolTip.Tip="Zoom out">
                                <TextBlock Text="−"/>
                            </Button>
                            <TextBlock Text="{Binding ZoomFactor, StringFormat='{}{0:F0} px/s'}"
                                       FontFamily="Consolas" FontSize="10" Foreground="#8E9299"
                                       VerticalAlignment="Center" Width="52" TextAlignment="Center"/>
                            <Button Classes="ToolbarBtn" Command="{Binding ZoomInCommand}" Padding="6,2" ToolTip.Tip="Zoom in">
                                <TextBlock Text="+"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ToggleButton Classes="ChannelToggle" Width="52" IsChecked="{Binding IsSnapToGrid}" ToolTip.Tip="Snap to grid">
                        <TextBlock Text="SNAP"/>
                    </ToggleButton>

                    <Button Classes="ToolbarBtn" Command="{Binding ExportMixdownCommand}"
                            IsEnabled="{Binding !IsExporting}"
                            Background="#00FFA3" Foreground="#000000" FontWeight="Bold">
                        <TextBlock Text="⚡ Export Mixdown (.WAV)"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MULTI-TRACK ARRANGEMENT TIMELINE -->
        <Grid Grid.Row="1" RowDefinitions="28,*" ColumnDefinitions="220,3,*">

            <!-- Drag to resize the track header column -->
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                          Background="#2D2D2F" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" ZIndex="40"
                          ToolTip.Tip="Drag to resize track headers"/>

            <!-- Ruler gutter -->
            <Border Grid.Row="0" Grid.Column="0" Background="#121214"
                    BorderBrush="#2D2D2F" BorderThickness="0,0,1,1">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="TRACKS" FontSize="10" FontWeight="Bold" Foreground="#8E9299"/>
                    <Button Classes="ToolbarBtn" Command="{Binding AddTrackCommand}"
                            Padding="6,1" FontSize="10" ToolTip.Tip="Add audio track">
                        <TextBlock Text="+ Add"/>
                    </Button>
                </StackPanel>
            </Border>

            <!--
                The ruler is not in its own ScrollViewer. It is translated by the
                lane viewer's horizontal offset, which keeps it perfectly locked
                to the lanes without two scrollers fighting over a shared offset.
            -->
            <Border Grid.Row="0" Grid.Column="2" Background="#121214"
                    BorderBrush="#2D2D2F" BorderThickness="0,0,0,1" ClipToBounds="True">
                <controls:TimelineRuler
                    x:Name="Ruler"
                    HorizontalAlignment="Left"
                    TotalDuration="{Binding TimelineDurationSeconds}"
                    PixelsPerSecond="{Binding ZoomFactor}"
                    CurrentTime="{Binding CurrentPlayheadSeconds}"
                    IsLooping="{Binding IsLooping}"
                    LoopStart="{Binding LoopStartSeconds}"
                    LoopEnd="{Binding LoopEndSeconds}"
                    ScrubCommand="{Binding ScrubToCommand}"
                    RenderTransform="{Binding #LaneScroll.Offset, Converter={StaticResource ScrollOffsetToTransform}, ConverterParameter=X}"/>
            </Border>

            <!-- Track headers, translated by the lane viewer's vertical offset -->
            <Border Grid.Row="1" Grid.Column="0" Background="#1A1A1C"
                    BorderBrush="#2D2D2F" BorderThickness="0,0,1,0" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Tracks}"
                              VerticalAlignment="Top"
                              RenderTransform="{Binding #LaneScroll.Offset, Converter={StaticResource ScrollOffsetToTransform}, ConverterParameter=Y}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioTrack">
                            <Border Height="96" Background="#181818" BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid ColumnDefinitions="4,*">
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,6,0"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11"
                                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                                     Padding="0" ToolTip.Tip="Rename track"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button Classes="ToolbarBtn" Padding="4,0" FontSize="9"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveTrackUpCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Move up">
                                                    <TextBlock Text="▲"/>
                                                </Button>
                                                <Button Classes="ToolbarBtn" Padding="4,0" FontSize="9"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveTrackDownCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Move down">
                                                    <TextBlock Text="▼"/>
                                                </Button>
                                                <Button Classes="ToolbarBtn" Padding="4,0" FontSize="9" Foreground="#FF4444"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteTrackCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Delete track">
                                                    <TextBlock Text="✕"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*">
                                            <ToggleButton Grid.Column="0" Content="Mute" Classes="ChannelToggle Mute"
                                                          IsChecked="{Binding IsMuted}" Margin="0,0,2,0"/>
                                            <ToggleButton Grid.Column="1" Content="Solo" Classes="ChannelToggle Solo"
                                                          IsChecked="{Binding IsSoloed}" Margin="2,0,0,0"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="VOL" FontSize="8" Foreground="#8E9299" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="-36" Maximum="6" Value="{Binding VolumeDb}" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VolumeDb, StringFormat='{}{0:F1}'}"
                                                       FontFamily="Consolas" FontSize="9" Foreground="#8E9299"
                                                       Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="PAN" FontSize="8" Foreground="#8E9299" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Pan}" Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Pan, StringFormat='{}{0:F2}'}"
                                                       FontFamily="Consolas" FontSize="9" Foreground="#8E9299"
                                                       Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Lanes: the single source of scroll offset for the whole timeline -->
            <ScrollViewer Grid.Row="1" Grid.Column="2" x:Name="LaneScroll"
                          PointerWheelChanged="OnLaneWheel"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#141416">
                <Panel Width="{Binding TimelineWidthPixels}" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding Tracks}" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioTrack">
                                <Border Height="96" BorderBrush="#252525" BorderThickness="0,0,0,1" Background="#141416">
                                    <ItemsControl ItemsSource="{Binding Clips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:TimelineLanePanel
                                                    PixelsPerSecond="{Binding $parent[Window].((vm:MainViewModel)DataContext).ZoomFactor}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AudioClip">
                                                <controls:AudioClipView
                                                    ClipModel="{Binding}"
                                                    OwnerTrack="{Binding $parent[ItemsControl].DataContext}"
                                                    PixelsPerSecond="{Binding $parent[Window].((vm:MainViewModel)DataContext).ZoomFactor}"
                                                    SnapToGrid="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsSnapToGrid}"
                                                    GridSizeSeconds="{Binding $parent[Window].((vm:MainViewModel)DataContext).GridSizeSeconds}"
                                                    SelectCommand="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectClipCommand}"
                                                    EditCommittedCommand="{Binding $parent[Window].((vm:MainViewModel)DataContext).CommitClipEditCommand}">
                                                    <controls:AudioClipView.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Split at Playhead"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SplitClipAtPlayheadCommand}"/>
                                                            <MenuItem Header="Duplicate"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DuplicateSelectedClipCommand}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Delete Clip"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSelectedClipCommand}"/>
                                                        </ContextMenu>
                                                    </controls:AudioClipView.ContextMenu>
                                                </controls:AudioClipView>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Draggable playhead. Hit-transparent except near the needle,
                         so clips underneath still receive pointer input. -->
                    <Canvas>
                        <controls:PlayheadView
                            Canvas.Left="{Binding PlayheadCanvasLeft}"
                            Canvas.Top="0"
                            Height="4000"
                            CurrentTime="{Binding CurrentPlayheadSeconds}"
                            PixelsPerSecond="{Binding ZoomFactor}"
                            TotalDuration="{Binding TimelineDurationSeconds}"
                            SnapToGrid="{Binding IsSnapToGrid}"
                            GridSizeSeconds="{Binding GridSizeSeconds}"
                            ScrubCommand="{Binding ScrubToCommand}"/>
                    </Canvas>
                </Panel>
            </ScrollViewer>
        </Grid>

        <!-- 3. STATUS / TIMELINE RULER DIVIDER -->
        <Border Grid.Row="2" Background="#161616" BorderBrush="#262626" BorderThickness="0,1" Height="24" Padding="8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" FontFamily="Consolas" Foreground="#00D2FF" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="8"
                                 IsVisible="{Binding IsImporting}" VerticalAlignment="Center"/>
                    <ProgressBar Value="{Binding ExportProgress}" Minimum="0" Maximum="100"
                                 Width="160" Height="8" IsVisible="{Binding IsExporting}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. BOTTOM DOCK (MASTERING DSP & METADATA INSPECTOR) -->
        <TabControl Grid.Row="3" Background="#141414" TabStripPlacement="Top">
            <!-- Tab 1: DSP Mastering Chain -->
            <TabItem Header="Mastering DSP Chain">
                <Grid ColumnDefinitions="*,*,*" Margin="12">
                    <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="HARSH CUT (>12 kHz)" FontWeight="Bold" Foreground="#00D2FF"/>
                            <TextBlock Text="Cuts brittle high frequencies with high-shelf curve." FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="-12" Maximum="0" Value="{Binding DspSettings.HighCutBand.GainDb}"/>
                            <TextBlock Text="{Binding DspSettings.HighCutBand.GainDb, StringFormat='{}{0:F1} dB'}"
                                       FontFamily="Consolas" FontSize="11" Foreground="#ECECEC"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="6,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="MUD SCOOP (200 - 400 Hz)" FontWeight="Bold" Foreground="#FFAA00"/>
                            <TextBlock Text="Removes boxy, muddy low-mid build-up." FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="-12" Maximum="3" Value="{Binding DspSettings.MudScoopBand.GainDb}"/>
                            <TextBlock Text="{Binding DspSettings.MudScoopBand.GainDb, StringFormat='{}{0:F1} dB'}"
                                       FontFamily="Consolas" FontSize="11" Foreground="#ECECEC"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TRUE-PEAK LIMITER &amp; -14 LUFS" FontWeight="Bold" Foreground="#00FFA3"/>
                            <TextBlock Text="Inter-sample peak limiter targeting streaming standards." FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                            <Slider Minimum="-3" Maximum="-0.1" Value="{Binding DspSettings.Limiter.CeilingDb}"/>
                            <TextBlock Text="{Binding DspSettings.Limiter.CeilingDb, StringFormat='{}{0:F1} dBTP'}"
                                       FontFamily="Consolas" FontSize="11" Foreground="#ECECEC"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Clip Inspector -->
            <TabItem Header="Clip Inspector">
                <Panel Margin="12">
                    <TextBlock Text="No clip selected — click a clip on the timeline."
                               Foreground="#8E9299" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasSelectedClip}"/>

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,*"
                          IsVisible="{Binding HasSelectedClip}">

                        <Border Grid.Row="1" Grid.Column="0" Background="#1A1A1C" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="CLIP" FontWeight="Bold" FontSize="10" Foreground="#8E9299"/>
                                <TextBox Text="{Binding SelectedClip.Name}" Background="#121214" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedClip.TimelineStartSeconds, StringFormat='Start: {0:F3} s'}"
                                           FontFamily="Consolas" FontSize="11" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding SelectedClip.ClipDurationSeconds, StringFormat='Length: {0:F3} s'}"
                                           FontFamily="Consolas" FontSize="11" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding SelectedClip.ClipOffsetSeconds, StringFormat='Source offset: {0:F3} s'}"
                                           FontFamily="Consolas" FontSize="11" Foreground="#8E9299"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#1A1A1C" CornerRadius="6" Padding="12" Margin="6,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="GAIN &amp; FADES" FontWeight="Bold" FontSize="10" Foreground="#8E9299"/>
                                <TextBlock Text="{Binding SelectedClip.GainDb, StringFormat='Gain: {0:F1} dB'}"
                                           FontFamily="Consolas" FontSize="11" Foreground="#4FC3F7"/>
                                <Slider Minimum="-24" Maximum="12" Value="{Binding SelectedClip.GainDb}"/>
                                <TextBlock Text="{Binding SelectedClip.FadeInSeconds, StringFormat='Fade in: {0:F2} s'}"
                                           FontFamily="Consolas" FontSize="11" Foreground="#8E9299"/>
                                <Slider Minimum="0" Maximum="4" Value="{Binding SelectedClip.FadeInSeconds}"/>
                                <TextBlock Text="{Binding SelectedClip.FadeOutSeconds, StringFormat='Fade out: {0:F2} s'}"
                                           FontFamily="Consolas" FontSize="11" Foreground="#8E9299"/>
                                <Slider Minimum="0" Maximum="4" Value="{Binding SelectedClip.FadeOutSeconds}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Background="#1A1A1C" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="ACTIONS" FontWeight="Bold" FontSize="10" Foreground="#8E9299"/>
                                <Button Classes="ToolbarBtn" HorizontalAlignment="Stretch"
                                        Command="{Binding SplitClipAtPlayheadCommand}">
                                    <TextBlock Text="✂ Split at Playhead"/>
                                </Button>
                                <Button Classes="ToolbarBtn" HorizontalAlignment="Stretch"
                                        Command="{Binding DuplicateSelectedClipCommand}">
                                    <TextBlock Text="⧉ Duplicate"/>
                                </Button>
                                <Button Classes="ToolbarBtn" HorizontalAlignment="Stretch" Foreground="#FF4444"
                                        Command="{Binding DeleteSelectedClipCommand}">
                                    <TextBlock Text="✕ Delete Clip"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Panel>
            </TabItem>

            <!-- Tab 3: TagLibSharp Metadata -->
            <TabItem Header="Metadata Inspector (TagLibSharp)">
                <Grid ColumnDefinitions="*,*" Margin="12">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                        <TextBlock Text="Title:" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Metadata.Title}" Background="#202020"/>
                        <TextBlock Text="Artist:" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Metadata.Artist}" Background="#202020"/>
                        <TextBlock Text="Album:" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Metadata.Album}" Background="#202020"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                        <TextBlock Text="ISRC Code:" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Metadata.Isrc}" Background="#202020"/>
                        <TextBlock Text="BPM:" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Metadata.Bpm}" Background="#202020"/>
                        <TextBlock Text="Copyright:" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBox Text="{Binding Metadata.Copyright}" Background="#202020"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
