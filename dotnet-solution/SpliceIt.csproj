<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>SpliceIt</RootNamespace>
    <AssemblyName>SpliceIt</AssemblyName>
    <!-- High-performance DSP optimizations -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!--
      Media Foundation (used for audio decode) is Windows-only, so the RID is
      pinned. Cross-platform decode arrives with FFmpeg in Phase 3.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI 11+ Fluent Framework -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />

    <!-- MVVM Community Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Audio Metadata Management (ID3v1, ID3v2, Vorbis, FLAC, MP4) -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />

    <!--
      Audio playback & decode.

      Was: NAudio.Core, which contains NO output device (WasapiOut / WaveOutEvent
      live in the full NAudio package) and cannot decode MP3/AAC/FLAC. Playback
      and import were therefore impossible with the previous package set.

      The full NAudio package brings WasapiOut plus MediaFoundationReader, which
      decodes WAV / MP3 / AAC / WMA and — on Windows 10 and later — FLAC.
      NAudio.Vorbis covers OGG, which Media Foundation does not handle.

      Removed:
        NAudio.WaveFormRenderer  -> renders to System.Drawing.Bitmap (GDI+),
                                    which cannot compose with Avalonia at all.
                                    Waveforms are drawn with DrawingContext instead.
        MathNet.Filtering        -> never referenced anywhere in the project.
    -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>
</Project>
